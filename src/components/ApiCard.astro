---
interface Props {
  id: string;
  name: string;
  description: string;
  url: string;
  category: string;
  tags: string[];
  authType: string;
  pricing: string;
  hasFreeQuota: boolean;
  status: string;
}

const { id, name, description, url, category, tags, authType, pricing, hasFreeQuota, status } = Astro.props;

const categoryLabels: Record<string, string> = {
  'openai-compatible': 'OpenAI 兼容',
  'multi-provider': '多模型聚合',
  'claude-api': 'Claude API',
  'image-gen': '图像生成',
  speech: '语音合成',
  embedding: '向量嵌入',
  other: '其他',
};

const categoryStyles: Record<string, string> = {
  'openai-compatible': 'bg-blue-50 text-blue-700 ring-blue-600/20',
  'multi-provider': 'bg-purple-50 text-purple-700 ring-purple-600/20',
  'claude-api': 'bg-orange-50 text-orange-700 ring-orange-600/20',
  'image-gen': 'bg-pink-50 text-pink-700 ring-pink-600/20',
  speech: 'bg-green-50 text-green-700 ring-green-600/20',
  embedding: 'bg-cyan-50 text-cyan-700 ring-cyan-600/20',
  other: 'bg-gray-50 text-gray-700 ring-gray-600/20',
};

const authLabels: Record<string, string> = {
  'api-key': 'API Key',
  oauth: 'OAuth',
  token: '令牌认证',
  free: '无需认证',
  mixed: '混合认证',
};

const pricingLabels: Record<string, string> = {
  free: '免费',
  freemium: '免费增值',
  paid: '付费',
  'pay-as-you-go': '按量付费',
};

const statusConfig: Record<string, { label: string; color: string }> = {
  active: { label: '正常运行', color: 'bg-emerald-500' },
  maintenance: { label: '维护中', color: 'bg-amber-400' },
  deprecated: { label: '已停用', color: 'bg-red-500' },
};

const currentStatus = statusConfig[status] ?? statusConfig.deprecated;
const categoryStyle = categoryStyles[category] ?? categoryStyles.other;
---

<article
  class="api-card group flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-primary-200 hover:shadow-lg sm:p-6"
  data-name={name}
  data-description={description}
  data-tags={tags.join(' ')}
  data-category={category}
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <span class:list={["inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset", categoryStyle]}>
      {categoryLabels[category] ?? categoryLabels.other}
    </span>
    <span class="inline-flex shrink-0 items-center gap-1.5 text-xs font-medium text-gray-500" title={currentStatus.label}>
      <span class:list={["h-2 w-2 rounded-full", currentStatus.color]}></span>
      {currentStatus.label}
    </span>
  </div>

  <h2 class="text-xl font-bold tracking-tight text-gray-950">
    <a class="transition-colors group-hover:text-primary-600" href={`/api/${id}`}>{name}</a>
  </h2>
  <p class="mt-3 flex-1 text-sm leading-6 text-gray-600">{description}</p>

  <div class="mt-5 flex flex-wrap gap-2" aria-label="服务信息">
    <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
      {authLabels[authType] ?? authType}
    </span>
    <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
      {pricingLabels[pricing] ?? pricing}
    </span>
    {hasFreeQuota && (
      <span class="rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">含免费额度</span>
    )}
  </div>

  {tags.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-gray-400" aria-label="标签">
      {tags.map((tag) => <li>#{tag}</li>)}
    </ul>
  )}

  <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-4">
    <a class="text-sm font-semibold text-primary-600 transition-colors hover:text-primary-700" href={`/api/${id}`}>
      查看详情
    </a>
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg bg-primary-500 px-3.5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
      aria-label={`访问 ${name} 官方网站（新窗口打开）`}
    >
      访问
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M7 13 13 7m-5-2h7v7M15 11v4H5V5h4"></path>
      </svg>
    </a>
  </div>
</article>